# Match the font used by the iTerm2 Default and tmux profiles.
font-family = Monaco
font-size = 16

# Match iTerm2's black background with zero transparency.
background = #000000
background-opacity = 1

# Match iTerm2's light gray text.
foreground = #bbbbbb

# Match iTerm2's white bold text and bright ANSI bold colors.
bold-color = #ffffff

# Steady vertical cursor.
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 300%

# Restore windows, tabs, splits, and working directories on macOS.
window-save-state = always

# Match the ANSI colors in the iTerm2 Default profile.
palette = 0=#000000
palette = 1=#bb0000
palette = 2=#00bb00
palette = 3=#bbbb00
palette = 4=#0000bb
palette = 5=#bb00bb
palette = 6=#00bbbb
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff
